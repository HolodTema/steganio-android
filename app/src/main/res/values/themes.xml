<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SteganioLight" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimaryLight</item>
        <item name="colorSecondary">@color/colorSecondaryLight</item>
        <item name="colorOnPrimary">@color/colorOnPrimaryLight</item>
        <item name="colorOnSecondary">@color/colorOnSecondaryLight</item>
        <item name="colorSurface">@color/colorSurfaceLight</item>
        <item name="colorOnSurface">@color/colorOnSurfaceLight</item>
        <item name="colorBackground">@color/colorBackgroundLight</item>
        <item name="colorOnBackground">@color/colorOnBackgroundLight</item>
        <item name="colorOnBackgroundDisabled">@color/colorOnBackgroundDisabledLight</item>
        <item name="colorError">@color/colorErrorLight</item>
        <item name="colorOnError">@color/colorOnErrorLight</item>
        <item name="colorTabIndicator">@color/colorTabIndicatorLight</item>

        <item name="android:statusBarColor">@color/colorSecondaryLight</item>

        <item name="android:windowAnimationStyle">@style/CustomActivityAnimation</item>
    </style>

    <style name="Theme.SteganioDark" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorSecondaryDark</item>
        <item name="colorOnPrimary">@color/colorOnPrimaryDark</item>
        <item name="colorOnSecondary">@color/colorOnSecondaryDark</item>
        <item name="colorSurface">@color/colorSurfaceDark</item>
        <item name="colorOnSurface">@color/colorOnSurfaceDark</item>
        <item name="colorBackground">@color/colorBackgroundDark</item>
        <item name="colorOnBackground">@color/colorOnBackgroundDark</item>
        <item name="colorOnBackgroundDisabled">@color/colorOnBackgroundDisabledDark</item>
        <item name="colorError">@color/colorErrorDark</item>
        <item name="colorOnError">@color/colorOnErrorDark</item>
        <item name="colorTabIndicator">@color/colorTabIndicatorDark</item>

        <item name="android:statusBarColor">@color/colorSecondaryDark</item>

        <item name="android:windowAnimationStyle">@style/CustomActivityAnimation</item>
    </style>

    <style name="CustomActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/anim_slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/anim_slide_out_left</item>
    </style>
</resources>