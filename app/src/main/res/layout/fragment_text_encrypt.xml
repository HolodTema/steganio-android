<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/textCaptionTextEncryption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Encrypt secret text inside text container"
                android:textColor="?attr/colorOnBackground"
                android:textSize="18sp"
                app:layout_constraintEnd_toStartOf="@+id/buttonLearnMore"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/buttonLearnMore"
                android:text="Learn more"
                android:textAllCaps="false"
                android:background="@drawable/background_button"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="10dp"/>

            <TextView
                android:id="@+id/textCaptionChooseAlgorithm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="15dp"
                android:text="Choose algorithm:"
                android:textColor="?attr/colorOnBackground"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonLearnMore" />

            <Spinner
                android:id="@+id/spinnerAlgorithm"
                android:layout_width="0dp"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@+id/textCaptionChooseAlgorithm"
                app:layout_constraintStart_toEndOf="@+id/textCaptionChooseAlgorithm"
                app:layout_constraintTop_toTopOf="@+id/textCaptionChooseAlgorithm" />

            <TextView
                android:id="@+id/textCaptionEncryptionKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generate encryption key:"
                android:textColor="?attr/colorOnBackground"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/textCaptionChooseAlgorithm"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="15dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEncryptionKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/textCaptionEncryptionKey"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textCaptionEncryptionKey"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textCaptionContainer"
                android:text="Text container:"
                android:textSize="18sp"
                android:textColor="?attr/colorOnBackground"
                app:layout_constraintTop_toBottomOf="@id/switchEncryptionKey"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="10dp"/>

            <EditText
                android:inputType="textMultiLine"
                android:id="@+id/editContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/textCaptionContainer"
                android:layout_marginHorizontal="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textCaptionSecret"
                android:text="Secret text:"
                android:textSize="18sp"
                android:textColor="?attr/colorOnBackground"
                app:layout_constraintTop_toBottomOf="@id/editContainer"
                android:layout_marginTop="15dp"
                android:layout_marginHorizontal="10dp"/>

            <EditText
                android:id="@+id/editSecret"
                android:inputType="textMultiLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/textCaptionSecret"
                android:layout_marginHorizontal="10dp"/>

            <TextView
                android:id="@+id/textCaptionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status:"
                android:textColor="?attr/colorOnBackground"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toTopOf="@id/textStatus"
                app:layout_constraintBottom_toBottomOf="@id/textStatus"/>

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="You do not use encryption key right now - it means you are using public key. With public key everybody can decrypt your text and know your secret! It is better to generate encryption keys for better defence."
                android:textColor="?attr/colorOnBackground"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/editSecret"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/textCaptionStatus"
                android:layout_marginStart="10dp"
                />

            <Button
                android:id="@+id/buttonEncrypt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/background_button"
                android:text="Encrypt"
                android:textAllCaps="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textStatus"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/textCaptionResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Result:"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:textSize="18sp"
                android:textColor="?attr/colorOnBackground"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonEncrypt" />

            <TextView
                android:id="@+id/textResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Text result"
                android:textColor="?attr/colorOnBackground"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@+id/textCaptionResult"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="5dp"/>

            <Button
                android:id="@+id/buttonCopyResultText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/background_button"
                android:text="Copy result text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textResult"
                android:layout_marginTop="10dp"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textCaptionKey"
                android:textSize="18sp"
                android:textColor="?attr/colorOnBackground"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textKey"
                app:layout_constraintBottom_toBottomOf="@id/textKey"
                android:layout_marginStart="10dp"
                android:text="Encryption key:"/>

            <TextView
                android:id="@+id/textKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="steganio://abcdefghijkmnlopqrstuvwxyz"
                android:textColor="?attr/colorOnBackground"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@+id/buttonCopyResultText"
                app:layout_constraintEnd_toStartOf="@+id/buttonCopyKey"
                android:layout_marginHorizontal="5dp"
                app:layout_constraintStart_toEndOf="@+id/textCaptionKey"
                android:layout_marginTop="15dp"/>

            <Button
                android:id="@+id/buttonCopyKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/background_button"
                android:text="Copy key"
                android:layout_marginEnd="10dp"
                android:textAllCaps="false"
                app:layout_constraintTop_toTopOf="@id/textKey"
                app:layout_constraintBottom_toBottomOf="@id/textKey"
                app:layout_constraintEnd_toEndOf="parent" />






        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>